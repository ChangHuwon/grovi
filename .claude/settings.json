{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/user/grovi && bash evals/validate.sh 2>&1 | tail -30",
            "timeout": 15,
            "statusMessage": "GROVI 검수 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash evals/validate.sh *)",
      "Bash(python3 -m http.server *)"
    ]
  }
}
